# Option 1 — Free local AI (recommended, no API key, no billing):
AI_PROVIDER=ollama
OLLAMA_MODEL=llama3.2

# Option 2 — Free cloud AI (Google Gemini):
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.5-flash

# Option 3 — Paid (OpenAI):
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here

PORT=3001

# Feedback email (Resend — https://resend.com)
# RESEND_API_KEY=re_xxxxxxxx
# FEEDBACK_TO_EMAIL=you@example.com
# FEEDBACK_FROM_EMAIL=onboarding@resend.dev
